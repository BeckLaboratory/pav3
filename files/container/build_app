#!/usr/bin/env bash

# Build an Apptainer/Singularity image (.sif) from an already-built PAV3 Docker
# image. The Docker image (pav3:<version>) is read straight from the local
# Docker daemon, so no intermediate tar archive is needed.
#
# Build the Docker image first with files/container/build_docker.
#
# Runs correctly regardless of the current working directory: the PAV directory
# is found relative to this script's location unless overridden with --dir.
#
# Usage:
#   files/container/build_app [options] [-- apptainer build args...]
#
# Options:
#   -d, --dir DIR          PAV directory (resolved relative to CWD). Overrides
#                          the location auto-detected from this script.
#   -p, --pav-version VER  PAV version to build (e.g. 3.0.0.dev22). Defaults to
#                          the newest wheel in <PAV_DIR>/dist.
#   -o, --out PATH         Output .sif path (relative to CWD). "<version>" in
#                          the path is replaced with the PAV version. If PATH is
#                          an existing directory, "pav3_<version>.sif" is written
#                          there. Default: <PAV_DIR>/apptainer/pav3_<version>.sif
#   -t, --tempdir DIR      Scratch directory for the build (APPTAINER_TMPDIR).
#                          Default: the system temporary directory.
#   -f, --force            Overwrite the output image if it already exists.
#   -n, --pretend          Print the commands without running them.
#   -q, --quiet            Suppress per-step progress messages.
#   -h, --help             Print this help and exit.
#
# Any unrecognized arguments, and anything after a literal "--", are passed
# through to the underlying "apptainer build" command.

set -euo pipefail

# Print the leading comment block (everything after the shebang up to the first
# non-comment line) as help text.
usage() {
    awk 'NR==1 { next } /^#/ { started=1; sub(/^# ?/, ""); print; next } started { exit }' "$0"
}

err() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'warning: %s\n' "$*" >&2
}


### Resolve this script's directory (following symlinks) ###

SCRIPT_SOURCE="${BASH_SOURCE[0]}"

while [[ -h "$SCRIPT_SOURCE" ]]; do
    dir="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="${dir}/${SCRIPT_SOURCE}"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"


### Parse arguments ###

DIR_ARG=""
PAV_VERSION=""
OUT_ARG=""
TEMPDIR_ARG=""
FORCE=""
PRETEND=""
QUIET=""
EXTRA=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dir)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            DIR_ARG="$2"; shift 2 ;;
        -p|--pav-version)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            PAV_VERSION="$2"; shift 2 ;;
        -o|--out)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            OUT_ARG="$2"; shift 2 ;;
        -t|--tempdir)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            TEMPDIR_ARG="$2"; shift 2 ;;
        -f|--force)   FORCE=1; shift ;;
        -n|--pretend) PRETEND=1; shift ;;
        -q|--quiet)   QUIET=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        --)           shift; EXTRA+=("$@"); break ;;
        *)            EXTRA+=("$1"); shift ;;
    esac
done


### Helpers ###

# Print a progress message unless running quiet.
progress() {
    [[ -n "$QUIET" ]] || printf '==> %s\n' "$*"
}

# Run a command, echoing it first when pretending. Under --pretend the command
# is printed but not executed.
run() {
    if [[ -n "$PRETEND" ]]; then
        printf '+'; printf ' %q' "$@"; printf '\n'
        return 0
    fi
    "$@"
}


### Resolve the PAV directory ###

if [[ -n "$DIR_ARG" ]]; then
    # Resolve --dir relative to the current working directory.
    PAV_DIR="$(cd "$DIR_ARG" 2>/dev/null && pwd)" \
        || err "PAV directory not found (--dir): ${DIR_ARG}"
else
    # Resolve "../.." relative to this script (files/container -> repo root).
    PAV_DIR="$(cd "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd)" \
        || err "Could not resolve PAV directory from script location: ${SCRIPT_DIR}"
fi

DIST_DIR="${PAV_DIR}/dist"


### Determine the PAV version ###

if [[ -z "$PAV_VERSION" ]]; then
    # Auto-detect the newest wheel (same logic as files/docker/build).
    shopt -s nullglob
    wheels=("${DIST_DIR}"/pav3-*.whl)
    shopt -u nullglob

    [[ ${#wheels[@]} -gt 0 ]] \
        || err "No PAV wheel files found in ${DIST_DIR}. Run \"uv build\" to generate one, or set the version with \"-p <version>\"."

    PAV_VERSION="$(ls "${DIST_DIR}"/pav3-*.whl | sort -V | tail -1 | sed -E 's/.*pav3-(.*)-py3.*/\1/')"

    # Warn (non-fatal) if the newest wheel does not match the in-tree version.
    INIT_FILE="${PAV_DIR}/src/pav3/__init__.py"
    SRC_VERSION="$(sed -nE "s/^__version__[[:space:]]*=[[:space:]]*['\"]([^'\"]+)['\"].*/\1/p" "$INIT_FILE" 2>/dev/null || true)"

    if [[ "$PAV_VERSION" != "$SRC_VERSION" ]]; then
        warn "Latest wheel version (${PAV_VERSION}) does not match the source version (${SRC_VERSION:-not found}) in ${INIT_FILE}. Building from Docker image pav3:${PAV_VERSION}; run \"uv build\" or set \"-p <version>\" if this is unexpected."
    fi
fi


### Resolve the output path ###

if [[ -n "$OUT_ARG" ]]; then
    out="${OUT_ARG//<version>/$PAV_VERSION}"
    if [[ -d "$out" ]]; then
        OUT="${out%/}/pav3_${PAV_VERSION}.sif"
    else
        OUT="$out"
    fi
else
    OUT="${PAV_DIR}/apptainer/pav3_${PAV_VERSION}.sif"
fi

if [[ -e "$OUT" && -z "$FORCE" ]]; then
    err "Output image already exists: ${OUT}. Use -f/--force to overwrite."
fi


### Locate apptainer (or singularity) ###

APP="$(command -v apptainer || command -v singularity || true)"
if [[ -z "$APP" ]]; then
    [[ -n "$PRETEND" ]] && APP="apptainer" \
        || err "Neither \"apptainer\" nor \"singularity\" was found in PATH."
fi
APP="$(basename "$APP")"


### Build ###

SOURCE_IMAGE="docker-daemon://pav3:${PAV_VERSION}"

# Apptainer build scratch directory. Defaults to the system temp directory.
# Apptainer needs an existing, absolute path (it resolves the mount point), so
# make the path absolute relative to CWD; it is created below.
if [[ -n "$TEMPDIR_ARG" ]]; then
    case "$TEMPDIR_ARG" in
        /*) TEMPDIR_ABS="$TEMPDIR_ARG" ;;
        *)  TEMPDIR_ABS="$(pwd)/$TEMPDIR_ARG" ;;
    esac
    export APPTAINER_TMPDIR="$TEMPDIR_ABS"
    export SINGULARITY_TMPDIR="$TEMPDIR_ABS"
fi

BUILD_OPTS=()
[[ -n "$FORCE" ]] && BUILD_OPTS+=(--force)

progress "PAV directory:  ${PAV_DIR}"
progress "PAV version:    ${PAV_VERSION}"
progress "Source image:   ${SOURCE_IMAGE}"
progress "Output image:   ${OUT}"
[[ -n "$TEMPDIR_ARG" ]] && progress "Temp directory: ${TEMPDIR_ABS}"

# Ensure the output and scratch directories exist.
run mkdir -p "$(dirname "$OUT")"
[[ -n "$TEMPDIR_ARG" ]] && run mkdir -p "$TEMPDIR_ABS"

run "$APP" build \
    ${BUILD_OPTS[@]+"${BUILD_OPTS[@]}"} \
    ${EXTRA[@]+"${EXTRA[@]}"} \
    "$OUT" \
    "$SOURCE_IMAGE"

progress "Done. Built ${OUT}"
