#!/usr/bin/env bash

# Sign and push a built PAV3 Apptainer/Singularity image (.sif) to the GitHub
# Container Registry (GHCR) as an ORAS artifact.
#
# Signs the .sif (you will be prompted for the signing key passphrase) and
# pushes it as "<repo>:<version>" (and, by default, "<repo>:latest"). Build the
# .sif first with files/container/build_app.
#
# The signature is written into the .sif itself, so it survives the round trip
# through the registry: after "apptainer pull oras://<repo>:<version>" the
# image can be checked with "apptainer verify <image>.sif". (Converting the
# Docker image with "apptainer pull docker://..." would not carry a signature.)
#
# Runs correctly regardless of the current working directory: the PAV directory
# is found relative to this script's location unless overridden with --dir.
#
# Authentication: if a token is available (GHCR_TOKEN or --token-file), the
# script exports APPTAINER_DOCKER_USERNAME/PASSWORD (or the SINGULARITY_*
# equivalents) for the push only. Without one it assumes a prior
# "apptainer registry login". Exporting rather than running "registry login"
# keeps the token out of ~/.apptainer/remote.yaml, and the token is never
# passed on the command line, where it would be visible in "ps".
#
# GHCR requires the repository path to be lower case; it is lower-cased here so
# that "oras://ghcr.io/BeckLaboratory/..." cannot fail with "could not parse
# reference".
#
# Usage:
#   files/container/deploy_app [options] [-- apptainer push args...]
#
# Options:
#   -d, --dir DIR          PAV directory (resolved relative to CWD). Overrides
#                          the location auto-detected from this script.
#   -p, --pav-version VER  PAV version to push (e.g. 3.0.0.dev22). Defaults to
#                          the newest wheel in <PAV_DIR>/dist.
#   -o, --out PATH         Path to the .sif to push (relative to CWD). "<version>"
#                          in the path is replaced with the PAV version. If PATH
#                          is a directory, "pav3_<version>.sif" within it is used.
#                          Default: <PAV_DIR>/apptainer/pav3_<version>.sif
#   -r, --repo REF         Destination reference. Default: the GHCR repository
#                          below. Useful for rehearsing a push against a
#                          personal namespace (e.g.
#                          oras://ghcr.io/<user>/pav3-sif-test).
#   -u, --user USER        Registry username for login. Default: $GHCR_USER.
#   -T, --token-file FILE  Read the registry token from FILE instead of
#                          $GHCR_TOKEN. A trailing newline is stripped.
#   -S, --no-sign          Push without signing the image first.
#   -L, --no-latest        Do not also push the "latest" tag.
#   -n, --pretend          Print the commands without running them.
#   -q, --quiet            Suppress per-step progress messages.
#   -h, --help             Print this help and exit.
#
# Unrecognized options are rejected rather than forwarded, so a flag borrowed
# from build_app (for example "-t") fails here instead of being spliced into the
# "apptainer push" command line. Non-option arguments, and anything after a
# literal "--", are passed through to "apptainer push".

set -euo pipefail

# Destination registry reference (without the ":<tag>" suffix). Override with
# -r/--repo.
ORAS_REF="oras://ghcr.io/becklaboratory/pav3-sif"

# Print the leading comment block (everything after the shebang up to the first
# non-comment line) as help text.
usage() {
    awk 'NR==1 { next } /^#/ { started=1; sub(/^# ?/, ""); print; next } started { exit }' "$0"
}

err() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'warning: %s\n' "$*" >&2
}


### Resolve this script's directory (following symlinks) ###

SCRIPT_SOURCE="${BASH_SOURCE[0]}"

while [[ -h "$SCRIPT_SOURCE" ]]; do
    dir="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="${dir}/${SCRIPT_SOURCE}"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"


### Parse arguments ###

DIR_ARG=""
PAV_VERSION=""
OUT_ARG=""
REPO_ARG=""
USER_ARG=""
TOKEN_FILE=""
NOSIGN=""
NOLATEST=""
PRETEND=""
QUIET=""
EXTRA=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dir)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            DIR_ARG="$2"; shift 2 ;;
        -p|--pav-version)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            PAV_VERSION="$2"; shift 2 ;;
        -o|--out)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            OUT_ARG="$2"; shift 2 ;;
        -r|--repo)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            REPO_ARG="$2"; shift 2 ;;
        -u|--user)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            USER_ARG="$2"; shift 2 ;;
        -T|--token-file)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            TOKEN_FILE="$2"; shift 2 ;;
        -S|--no-sign)   NOSIGN=1; shift ;;
        -L|--no-latest) NOLATEST=1; shift ;;
        -n|--pretend)   PRETEND=1; shift ;;
        -q|--quiet)     QUIET=1; shift ;;
        -h|--help)      usage; exit 0 ;;
        --)             shift; EXTRA+=("$@"); break ;;
        -*)             err "Unknown option: $1. Options for \"apptainer push\" go after a literal \"--\"." ;;
        *)              EXTRA+=("$1"); shift ;;
    esac
done


### Helpers ###

# Print a progress message unless running quiet.
progress() {
    [[ -n "$QUIET" ]] || printf '==> %s\n' "$*"
}

# Run a command, echoing it first when pretending. Under --pretend the command
# is printed but not executed.
run() {
    if [[ -n "$PRETEND" ]]; then
        printf '+'; printf ' %q' "$@"; printf '\n'
        return 0
    fi
    "$@"
}

# Read a pushed reference back from the registry.
#
# "apptainer push" exiting 0 is not proof the artifact landed: GHCR applies a
# timeout to the push as a whole, and a large .sif can finish uploading its blob
# and then stall while the manifest is finalized, leaving no version behind.
#
# This is advisory only. The check runs through "docker manifest inspect", which
# is not guaranteed to accept an ORAS artifact's media type, so a negative result
# is reported as a warning rather than treated as a failed push.
verify_ref() {
    local ref="${1#*://}"

    [[ -n "$PRETEND" ]] && return 0

    if ! command -v docker >/dev/null 2>&1; then
        warn "docker not found, so ${ref} was not read back from the registry. Confirm with \"${APP} pull ${1}\"."
        return 0
    fi

    if docker manifest inspect "$ref" >/dev/null 2>&1; then
        progress "Confirmed in registry: ${ref}"
    else
        warn "Could not read ${ref} back from the registry. The push reported success, so this may just be \"docker manifest inspect\" refusing an ORAS artifact. Confirm with \"${APP} pull ${1}\"."
    fi
}


### Resolve the PAV directory ###

if [[ -n "$DIR_ARG" ]]; then
    # Resolve --dir relative to the current working directory.
    PAV_DIR="$(cd "$DIR_ARG" 2>/dev/null && pwd)" \
        || err "PAV directory not found (--dir): ${DIR_ARG}"
else
    # Resolve "../.." relative to this script (files/container -> repo root).
    PAV_DIR="$(cd "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd)" \
        || err "Could not resolve PAV directory from script location: ${SCRIPT_DIR}"
fi

DIST_DIR="${PAV_DIR}/dist"


### Determine the PAV version ###

if [[ -z "$PAV_VERSION" ]]; then
    # Auto-detect the newest wheel (same logic as files/container/build_app).
    shopt -s nullglob
    wheels=("${DIST_DIR}"/pav3-*.whl)
    shopt -u nullglob

    [[ ${#wheels[@]} -gt 0 ]] \
        || err "No PAV wheel files found in ${DIST_DIR}. Run \"uv build\" to generate one, or set the version with \"-p <version>\"."

    PAV_VERSION="$(ls "${DIST_DIR}"/pav3-*.whl | sort -V | tail -1 | sed -E 's/.*pav3-(.*)-py3.*/\1/')"

    # Warn (non-fatal) if the newest wheel does not match the in-tree version.
    INIT_FILE="${PAV_DIR}/src/pav3/__init__.py"
    SRC_VERSION="$(sed -nE "s/^__version__[[:space:]]*=[[:space:]]*['\"]([^'\"]+)['\"].*/\1/p" "$INIT_FILE" 2>/dev/null || true)"

    if [[ "$PAV_VERSION" != "$SRC_VERSION" ]]; then
        warn "Latest wheel version (${PAV_VERSION}) does not match the source version (${SRC_VERSION:-not found}) in ${INIT_FILE}. Pushing pav3_${PAV_VERSION}.sif; run \"uv build\" or set \"-p <version>\" if this is unexpected."
    fi
fi


### Resolve the .sif path (mirrors files/container/build_app) ###

if [[ -n "$OUT_ARG" ]]; then
    out="${OUT_ARG//<version>/$PAV_VERSION}"
    if [[ -d "$out" ]]; then
        SIF="${out%/}/pav3_${PAV_VERSION}.sif"
    else
        SIF="$out"
    fi
else
    SIF="${PAV_DIR}/apptainer/pav3_${PAV_VERSION}.sif"
fi

if [[ -z "$PRETEND" && ! -f "$SIF" ]]; then
    err "Image not found: ${SIF}. Build it first with files/container/build_app."
fi


### Resolve the destination reference ###

if [[ -n "$REPO_ARG" ]]; then
    ORAS_REF="$REPO_ARG"
fi

# Registries reject upper-case repository paths ("could not parse reference"),
# so normalize before the reference is ever constructed.
ORAS_REF="$(printf '%s' "$ORAS_REF" | tr '[:upper:]' '[:lower:]')"

# Registry host, for the login message: strip the "<scheme>://" prefix and take
# the first path segment.
REGISTRY_HOST="${ORAS_REF#*://}"
REGISTRY_HOST="${REGISTRY_HOST%%/*}"


### Locate apptainer (or singularity) ###

APP="$(command -v apptainer || command -v singularity || true)"

if [[ -z "$APP" ]]; then
    # Under --pretend there is nothing to execute, so name the command the
    # echoed lines would have used.
    if [[ -n "$PRETEND" ]]; then
        APP="apptainer"
    else
        err "Neither \"apptainer\" nor \"singularity\" was found in PATH."
    fi
fi
APP="$(basename "$APP")"


### Registry credentials ###

# "apptainer push" to an oras:// target reads the registry credentials from
# APPTAINER_DOCKER_USERNAME/APPTAINER_DOCKER_PASSWORD (SINGULARITY_* under
# singularity). Exporting them here scopes the token to this run: it avoids
# writing it to ~/.apptainer/remote.yaml the way "registry login" does, and
# avoids "--docker-password", which would expose it in "ps" and in the command
# echoed by run().
#
# Without a token, fall through and rely on the credentials already on the
# machine. Apptainer reads ~/.docker/config.json, so a plain "docker login
# ghcr.io" covers this script as well as deploy_docker; "apptainer registry
# login" writes the same file (and ~/.apptainer/remote.yaml). The one gap is a
# Docker credential helper: if config.json delegates to "credsStore", the token
# lives in an OS keyring that Apptainer cannot read, and a token must be given
# here instead.
REGISTRY_TOKEN=""

if [[ -n "$TOKEN_FILE" ]]; then
    [[ -f "$TOKEN_FILE" ]] || err "Token file not found (--token-file): ${TOKEN_FILE}"
    REGISTRY_TOKEN="$(<"$TOKEN_FILE")"
    REGISTRY_TOKEN="${REGISTRY_TOKEN%%$'\n'*}"
    [[ -n "$REGISTRY_TOKEN" ]] || err "Token file is empty: ${TOKEN_FILE}"
else
    REGISTRY_TOKEN="${GHCR_TOKEN:-}"
fi

if [[ -n "$REGISTRY_TOKEN" ]]; then
    REGISTRY_USER="${USER_ARG:-${GHCR_USER:-}}"
    [[ -n "$REGISTRY_USER" ]] \
        || err "A registry token was given but no username. Set \$GHCR_USER or pass \"-u <user>\"."

    if [[ "$APP" == "singularity" ]]; then
        ENV_PREFIX="SINGULARITY"
    else
        ENV_PREFIX="APPTAINER"
    fi

    export "${ENV_PREFIX}_DOCKER_USERNAME=${REGISTRY_USER}"
    export "${ENV_PREFIX}_DOCKER_PASSWORD=${REGISTRY_TOKEN}"

    AUTH_NOTE="${REGISTRY_USER} (via ${ENV_PREFIX}_DOCKER_USERNAME/PASSWORD)"
else
    AUTH_NOTE="none given; using existing login (~/.docker/config.json)"
fi


### Sign and push ###

# Report an incomplete run. Anything that fails below -- a missing signing key, an aborted passphrase prompt, a registry timeout -- exits
# through "set -e"; say plainly that nothing was published, so a run that stops
# partway is not mistaken for one that finished when the output has scrolled.
on_exit() {
    local rc=$?

    if [[ $rc -ne 0 ]]; then
        printf '\nerror: deploy failed (exit %d). %s was NOT pushed.\n' \
            "$rc" "${ORAS_REF}:${PAV_VERSION}" >&2
    fi
}

trap on_exit EXIT

progress "PAV directory:  ${PAV_DIR}"
progress "PAV version:    ${PAV_VERSION}"
progress "Image:          ${SIF}"
progress "Registry:       ${REGISTRY_HOST}"
progress "Repository:     ${ORAS_REF}"
progress "Credentials:    ${AUTH_NOTE}"

# Sign the image (prompts for the signing key passphrase) unless suppressed.
if [[ -z "$NOSIGN" ]]; then
    progress "Signing ${SIF}"
    run "$APP" sign "$SIF"
fi

# Versioned tag.
progress "Pushing ${ORAS_REF}:${PAV_VERSION}"
run "$APP" push ${EXTRA[@]+"${EXTRA[@]}"} "$SIF" "${ORAS_REF}:${PAV_VERSION}"
verify_ref "${ORAS_REF}:${PAV_VERSION}"

# "latest" tag (unless suppressed).
if [[ -z "$NOLATEST" ]]; then
    progress "Pushing ${ORAS_REF}:latest"
    run "$APP" push ${EXTRA[@]+"${EXTRA[@]}"} "$SIF" "${ORAS_REF}:latest"
    verify_ref "${ORAS_REF}:latest"
fi

progress "Done. Pushed ${ORAS_REF}:${PAV_VERSION}"
progress "Pull with:      ${APP} pull ${ORAS_REF}:${PAV_VERSION}"
progress "Note:           the first push of a package creates it PRIVATE. Until it is set public in the GitHub package settings, an anonymous pull fails with \"401 Unauthorized\"."
