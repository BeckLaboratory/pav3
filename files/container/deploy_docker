#!/usr/bin/env bash

# Push a built PAV3 Docker image to the GitHub Container Registry (GHCR).
#
# Tags the locally-built "pav3:<version>" image as "<repo>:<version>" (and, by
# default, "<repo>:latest") and pushes both. Build the image first with
# files/container/build_docker.
#
# Runs correctly regardless of the current working directory: the PAV directory
# is found relative to this script's location unless overridden with --dir.
#
# Authentication: if a token is available (GHCR_TOKEN or --token-file), the
# script logs in to the registry before pushing. Without one it assumes a prior
# "docker login" and lets "docker push" report any failure. The token is passed
# on stdin and is never placed in the command line or echoed.
#
# GHCR requires the repository path to be lower case; it is lower-cased here so
# that "ghcr.io/BeckLaboratory/pav3" cannot fail with "could not parse
# reference".
#
# Usage:
#   files/container/deploy_docker [options] [-- docker push args...]
#
# Options:
#   -d, --dir DIR          PAV directory (resolved relative to CWD). Overrides
#                          the location auto-detected from this script.
#   -p, --pav-version VER  PAV version to push (e.g. 3.0.0.dev22). Defaults to
#                          __version__ in <PAV_DIR>/src/pav3/__init__.py.
#   -r, --repo REPO        Destination repository. Default: the GHCR repository
#                          below. Useful for rehearsing a push against a
#                          personal namespace (e.g. ghcr.io/<user>/pav3-test).
#   -u, --user USER        Registry username for login. Default: $GHCR_USER.
#   -T, --token-file FILE  Read the registry token from FILE instead of
#                          $GHCR_TOKEN. A trailing newline is stripped.
#   -L, --no-latest        Do not also push the "latest" tag.
#   -n, --pretend          Print the docker commands without running them.
#   -v, --verbose          Print commands as they run.
#   -q, --quiet            Suppress per-step progress messages.
#   -h, --help             Print this help and exit.
#
# Unrecognized options are rejected rather than forwarded, so a flag borrowed
# from another script fails here instead of being spliced into the "docker push"
# command line. Non-option arguments, and anything after a literal "--", are
# passed through to "docker push".

set -euo pipefail

# Destination repository on the registry. Override with -r/--repo.
DOCKER_REPO="ghcr.io/becklaboratory/pav3"

# Print the leading comment block (everything after the shebang up to the first
# non-comment line) as help text.
usage() {
    awk 'NR==1 { next } /^#/ { started=1; sub(/^# ?/, ""); print; next } started { exit }' "$0"
}

err() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'warning: %s\n' "$*" >&2
}


### Resolve this script's directory (following symlinks) ###

SCRIPT_SOURCE="${BASH_SOURCE[0]}"

while [[ -h "$SCRIPT_SOURCE" ]]; do
    dir="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="${dir}/${SCRIPT_SOURCE}"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"


### Parse arguments ###

DIR_ARG=""
PAV_VERSION=""
REPO_ARG=""
USER_ARG=""
TOKEN_FILE=""
NOLATEST=""
PRETEND=""
VERBOSE=""
QUIET=""
EXTRA=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dir)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            DIR_ARG="$2"; shift 2 ;;
        -p|--pav-version)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            PAV_VERSION="$2"; shift 2 ;;
        -r|--repo)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            REPO_ARG="$2"; shift 2 ;;
        -u|--user)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            USER_ARG="$2"; shift 2 ;;
        -T|--token-file)
            [[ $# -ge 2 ]] || err "$1 requires an argument"
            TOKEN_FILE="$2"; shift 2 ;;
        -L|--no-latest) NOLATEST=1; shift ;;
        -n|--pretend)   PRETEND=1; shift ;;
        -v|--verbose)   VERBOSE=1; shift ;;
        -q|--quiet)     QUIET=1; shift ;;
        -h|--help)      usage; exit 0 ;;
        --)             shift; EXTRA+=("$@"); break ;;
        -*)             err "Unknown option: $1. Options for \"docker push\" go after a literal \"--\"." ;;
        *)              EXTRA+=("$1"); shift ;;
    esac
done


### Helpers ###

# Print a progress message unless running quiet.
progress() {
    [[ -n "$QUIET" ]] || printf '==> %s\n' "$*"
}

# Run a command, echoing it first when verbose or pretending. Under --pretend
# the command is printed but not executed.
run() {
    if [[ -n "$VERBOSE" || -n "$PRETEND" ]]; then
        printf '+'; printf ' %q' "$@"; printf '\n'
    fi
    [[ -n "$PRETEND" ]] && return 0
    "$@"
}

# Read a pushed tag back from the registry.
#
# "docker push" exiting 0 is normally conclusive, but GHCR applies a timeout to
# the push as a whole, so confirm the manifest is really there before the script
# claims the release landed.
verify_ref() {
    [[ -n "$PRETEND" ]] && return 0

    docker manifest inspect "$1" >/dev/null 2>&1 \
        || err "Push reported success but ${1} could not be read back from ${REGISTRY_HOST}. The tag was not published."

    progress "Confirmed in registry: ${1}"
}


### Resolve the PAV directory ###

if [[ -n "$DIR_ARG" ]]; then
    # Resolve --dir relative to the current working directory.
    PAV_DIR="$(cd "$DIR_ARG" 2>/dev/null && pwd)" \
        || err "PAV directory not found (--dir): ${DIR_ARG}"
else
    # Resolve "../.." relative to this script (files/container -> repo root).
    PAV_DIR="$(cd "${SCRIPT_DIR}/../.." >/dev/null 2>&1 && pwd)" \
        || err "Could not resolve PAV directory from script location: ${SCRIPT_DIR}"
fi


### Determine the PAV version ###

if [[ -z "$PAV_VERSION" ]]; then
    # Default to the in-tree version (same logic as files/container/build_docker).
    INIT_FILE="${PAV_DIR}/src/pav3/__init__.py"
    PAV_VERSION="$(sed -nE "s/^__version__[[:space:]]*=[[:space:]]*['\"]([^'\"]+)['\"].*/\1/p" "$INIT_FILE" 2>/dev/null || true)"

    [[ -n "$PAV_VERSION" ]] \
        || err "Could not read __version__ from ${INIT_FILE}. Set the version with \"-p <version>\"."
fi

LOCAL_IMAGE="pav3:${PAV_VERSION}"


### Resolve the destination repository ###

if [[ -n "$REPO_ARG" ]]; then
    DOCKER_REPO="$REPO_ARG"
fi

# Registries reject upper-case repository paths ("could not parse reference"),
# so normalize before the reference is ever constructed.
DOCKER_REPO="$(printf '%s' "$DOCKER_REPO" | tr '[:upper:]' '[:lower:]')"

# Registry host is the first path segment when it looks like a hostname
# (contains "." or ":"), otherwise the reference is a Docker Hub short name.
REGISTRY_HOST="${DOCKER_REPO%%/*}"
[[ "$REGISTRY_HOST" == *[.:]* ]] || REGISTRY_HOST="docker.io"


### Verify the local image exists ###

if [[ -z "$PRETEND" ]] && ! docker image inspect "$LOCAL_IMAGE" >/dev/null 2>&1; then
    err "Local image ${LOCAL_IMAGE} not found. Build it first with files/container/build_docker."
fi


### Push ###

progress "PAV directory:  ${PAV_DIR}"
progress "PAV version:    ${PAV_VERSION}"
progress "Local image:    ${LOCAL_IMAGE}"
progress "Registry:       ${REGISTRY_HOST}"
progress "Repository:     ${DOCKER_REPO}"

# Log in when a token is available. Without one, rely on an existing
# "docker login" and let "docker push" report the failure.
#
# The token is fed to docker on stdin and is deliberately not passed through
# run(), which echoes its arguments under --verbose and --pretend.
REGISTRY_TOKEN=""

if [[ -n "$TOKEN_FILE" ]]; then
    [[ -f "$TOKEN_FILE" ]] || err "Token file not found (--token-file): ${TOKEN_FILE}"
    REGISTRY_TOKEN="$(<"$TOKEN_FILE")"
    REGISTRY_TOKEN="${REGISTRY_TOKEN%%$'\n'*}"
    [[ -n "$REGISTRY_TOKEN" ]] || err "Token file is empty: ${TOKEN_FILE}"
else
    REGISTRY_TOKEN="${GHCR_TOKEN:-}"
fi

if [[ -n "$REGISTRY_TOKEN" ]]; then
    REGISTRY_USER="${USER_ARG:-${GHCR_USER:-}}"
    [[ -n "$REGISTRY_USER" ]] \
        || err "A registry token was given but no username. Set \$GHCR_USER or pass \"-u <user>\"."

    progress "Logging in to ${REGISTRY_HOST} as ${REGISTRY_USER}"

    if [[ -n "$VERBOSE" || -n "$PRETEND" ]]; then
        printf '+ docker login %q -u %q --password-stdin <<< <token>\n' \
            "$REGISTRY_HOST" "$REGISTRY_USER"
    fi

    if [[ -z "$PRETEND" ]]; then
        printf '%s' "$REGISTRY_TOKEN" \
            | docker login "$REGISTRY_HOST" -u "$REGISTRY_USER" --password-stdin \
            || err "Login to ${REGISTRY_HOST} failed. GHCR requires a classic personal access token with the \"write:packages\" scope."
    fi
else
    progress "No token given (\$GHCR_TOKEN or --token-file); using existing docker login"
fi

# Report an incomplete run. Anything that fails below -- a rejected login, a registry timeout -- exits
# through "set -e"; say plainly that nothing was published, so a run that stops
# partway is not mistaken for one that finished when the output has scrolled.
on_exit() {
    local rc=$?

    if [[ $rc -ne 0 ]]; then
        printf '\nerror: deploy failed (exit %d). %s was NOT pushed.\n' \
            "$rc" "${DOCKER_REPO}:${PAV_VERSION}" >&2
    fi
}

trap on_exit EXIT

# Versioned tag.
progress "Pushing ${DOCKER_REPO}:${PAV_VERSION}"
run docker tag "${LOCAL_IMAGE}" "${DOCKER_REPO}:${PAV_VERSION}"
run docker push ${EXTRA[@]+"${EXTRA[@]}"} "${DOCKER_REPO}:${PAV_VERSION}"
verify_ref "${DOCKER_REPO}:${PAV_VERSION}"

# "latest" tag (unless suppressed).
if [[ -z "$NOLATEST" ]]; then
    progress "Pushing ${DOCKER_REPO}:latest"
    run docker tag "${LOCAL_IMAGE}" "${DOCKER_REPO}:latest"
    run docker push ${EXTRA[@]+"${EXTRA[@]}"} "${DOCKER_REPO}:latest"
    verify_ref "${DOCKER_REPO}:latest"
fi

progress "Done. Pushed ${DOCKER_REPO}:${PAV_VERSION}"
progress "Pull with:      docker pull ${DOCKER_REPO}:${PAV_VERSION}"
progress "Note:           the first push of a package creates it PRIVATE. Until it is set public in the GitHub package settings, an anonymous pull fails with \"401 Unauthorized\"."
